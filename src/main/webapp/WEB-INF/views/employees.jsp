<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List" %><%@ page import="com.mayur.devops.model.Employee" %><html><head><title>Employees</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main><h1>Employees</h1><table><tr><th>ID</th><th>Name</th><th>Role</th></tr><% for(Employee e:(List<Employee>)request.getAttribute("employees")){ %><tr><td><%=e.id()%></td><td><%=e.name()%></td><td><%=e.role()%></td></tr><% } %></table></main></body></html>
